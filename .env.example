# Réglages de développement local (copier en .env). Sur Databricks Apps ces valeurs viennent de app.yaml.
APPRO_DATA_SOURCE=local            # local (seed CSV) | uc (SQL warehouse) | lakebase (tables erp_* de la base)
APPRO_SEED_DIR=./data/seed
APPRO_AS_OF=2026-09-19             # date de référence figée pour le jeu de démonstration (à retirer en production)
APPRO_HORIZON_DAYS=120
APPRO_DEFAULT_PLANNER=QUENTIN
# APPRO_SEED_REFERENCE=true        # charger le référentiel du seed si la base est vide (défaut : oui en local)
# APPRO_DB_URL=sqlite:///./data/local/appro.db
# --- mode uc : lecture des extractions ERP par un SQL warehouse
# APPRO_UC_CATALOG=emotors_data_champions
# APPRO_UC_SCHEMA=silver_erp_ye
# APPRO_ERP_ORDERS_TABLE=commandes_edi
# APPRO_ERP_RECEIPTS_TABLE=recep_edi
# APPRO_ERP_PRODUCTION_TABLE=      # vide = aucune production réelle lue
# DATABRICKS_WAREHOUSE_ID=...
# DATABRICKS_HOST=https://...
# --- test contre Lakebase depuis un poste (jeton d'une heure)
# APPRO_DB_URL=postgresql+psycopg://<user>:<token>@<host>:5432/databricks_postgres?sslmode=require
