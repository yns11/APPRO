# Local development settings (copy to .env). On Databricks Apps these come from app.yaml.
APPRO_DATA_SOURCE=local            # local | uc
APPRO_SEED_DIR=./data/seed
APPRO_AS_OF=2026-09-19             # fixed reference date for the demo dataset (remove in production)
APPRO_HORIZON_DAYS=120
APPRO_DEFAULT_PLANNER=QUENTIN
